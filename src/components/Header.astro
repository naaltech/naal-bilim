---
import bars3 from "heroicons/24/outline/bars-3.svg?raw"
import xMark from "heroicons/24/outline/x-mark.svg?raw"
import Icon from "@/components/Icon.astro"

const navItems = [
  { href: "/#atolye", label: "Atölye" },
  { href: "/dergi", label: "Dergi" },
  { href: "/#calistay", label: "Çalıştay" },
  { href: "/basvuru", label: "Başvuru" },
  { href: "/#instagram", label: "Instagram" },
]

const pathname = Astro.url.pathname.replace(/\.html$/, "")
---

<header class="sticky top-0 z-50 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center gap-3 text-xl font-bold text-foreground transition-colors hover:text-muted-foreground">
      <img src="/naalbilim.webp" alt="" width="52" height="38" decoding="async" class="h-auto w-10 sm:w-[52px]" />
      naalbilim
    </a>

    <nav class="hidden items-center space-x-8 md:flex">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`px-3 py-2 text-sm font-medium transition-colors ${
            pathname === item.href ? "text-foreground hover:text-muted-foreground" : "text-muted-foreground hover:text-foreground"
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      id="menu-button"
      class="inline-flex items-center justify-center rounded-md p-2 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Menüyü aç</span>
      <Icon svg={bars3} class="menu-open h-6 w-6" />
      <Icon svg={xMark} class="menu-close hidden h-6 w-6" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden space-y-1 border-t px-2 pb-3 pt-2 sm:px-3 md:hidden">
    {navItems.map((item) => (
      <a
        href={item.href}
        class={`block rounded-md px-3 py-2 text-base font-medium transition-colors ${
          pathname === item.href ? "bg-muted text-foreground" : "text-muted-foreground hover:bg-muted hover:text-foreground"
        }`}
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const button = document.querySelector("#menu-button")!
  const menu = document.querySelector("#mobile-menu")!

  function setMenuOpen(open: boolean) {
    menu.classList.toggle("hidden", !open)
    button.setAttribute("aria-expanded", String(open))
    button.querySelector(".menu-open")!.classList.toggle("hidden", open)
    button.querySelector(".menu-close")!.classList.toggle("hidden", !open)
  }

  button.addEventListener("click", () => setMenuOpen(menu.classList.contains("hidden")))
  menu.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenuOpen(false)))
</script>
