---
import arrowTopRightOnSquare from "heroicons/24/outline/arrow-top-right-on-square.svg?raw"
import Footer from "@/components/Footer.astro"
import Header from "@/components/Header.astro"
import Icon from "@/components/Icon.astro"
import NumberTag from "@/components/NumberTag.astro"
import SectionTitle from "@/components/SectionTitle.astro"
import Layout from "@/layouts/Layout.astro"
import { getClub, getMagazines, instagramHandle, issueLabel, splitList, toRoman } from "@/lib/supabase"

const paragraphs = [
  "Bilimin sınırı yok; her gün yeni bir soru, yeni bir cevap getiriyor. Biz de bilimi yalnızca okuyarak değil, konuşarak, tartışarak ve uzmanlara soru sorarak öğreniyoruz. Atölyemiz tam olarak bunun için var.",
  "Meraklı ve araştırmayı seven öğrencilerle söyleşiler düzenliyor, gezilere çıkıyor, çalıştaylar yapıyor ve belgeselleri birlikte inceliyoruz. Burada hem bilimi öğrenecek hem de bu süreçte eğleneceksin.",
]

const activities = [
  {
    numeral: "I",
    title: "Söyleşiler",
    text: "Alanında uzman bilim insanlarını okulumuzda ağırlıyor, merak ettiklerimizi doğrudan onlara soruyoruz.",
  },
  {
    numeral: "II",
    title: "Geziler",
    text: "Müzeleri, laboratuvarları ve araştırma merkezlerini ziyaret ederek bilimi yerinde görüyoruz.",
  },
  {
    numeral: "III",
    title: "Çalıştaylar",
    text: "İç ve dış çalıştaylarda kara delikler gibi farklı konuları araştırıp tartışıyoruz.",
  },
  {
    numeral: "IV",
    title: "Belgesel Analizleri",
    text: "Bilim belgesellerini birlikte izliyor, ardından bilimsel yönlerini konuşuyoruz.",
  },
  {
    numeral: "V",
    title: "Dergiler",
    text: "Bilim dergimizi hazırlıyor, öğrencilerimizin yazdığı bilim makalelerini bulmacalarla birlikte yayımlıyoruz.",
    href: "/dergi",
  },
]

const [club, magazines] = await Promise.all([getClub(), getMagazines()])
const magazine = magazines[0]
const instagramAccounts = splitList(club?.instagram ?? "naalbilim").map(instagramHandle)
---

<Layout>
  <Header />

  <main>
    <section class="bg-gradient-to-b from-muted/70 to-transparent py-20">
      <div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
        <img
          src="/naalbilim.webp"
          alt="Bilim Kulübü logosu"
          width="576"
          height="420"
          decoding="async"
          class="mx-auto mb-10 h-auto w-full max-w-xs sm:max-w-md"
        />
        <h1 class="mb-6 text-4xl font-bold text-foreground md:text-6xl">
          Nevzat Ayaz Anadolu Lisesi
          <span class="block text-muted-foreground">Bilim Kulübü</span>
        </h1>
        <p class="mx-auto mb-2 max-w-3xl text-xl text-muted-foreground">“Tüm bilginin sınavı deneydir.” — Richard Feynman</p>
        <p lang="en" class="mx-auto mb-8 max-w-3xl text-sm text-muted-foreground">“The test of all knowledge is experiment.”</p>
        <div class="mx-auto flex max-w-md flex-col items-center justify-center gap-3 sm:max-w-none sm:flex-row sm:gap-4">
          <a href="/basvuru" class="button w-full sm:w-auto">Başvuru Yap</a>
          <a href="mailto:bilim@naal.org.tr" class="button-outline w-full sm:w-auto">İletişim</a>
        </div>
      </div>
    </section>

    <section id="atolye" class="scroll-mt-16 py-16">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
        <div>
          <h2 class="mb-6 text-3xl font-bold text-foreground">Atölyemiz</h2>
          <div class="text-muted-foreground">
            {paragraphs.map((paragraph) => <p class="mb-4">{paragraph}</p>)}
          </div>
        </div>
        <figure>
          <img
            src="/fig-isik.webp"
            alt="Leonardo defteri üslubunda göz, mercek ve ışık ışınları çizimi"
            width="1200"
            height="936"
            loading="lazy"
            decoding="async"
            class="h-auto w-full"
          />
        </figure>
      </div>
    </section>

    <section class="bg-muted/60 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionTitle>Neler Yapıyoruz?</SectionTitle>
        <ol class="flex flex-wrap justify-center gap-6">
          {activities.map((activity, index) => (
            <li class="card w-full p-6 md:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
              <NumberTag index={index}>{activity.numeral}</NumberTag>
              <h3 class="mb-2 mt-3 text-lg font-semibold text-foreground">
                {activity.href ? (
                  <a href={activity.href} class="hover:underline">{activity.title}</a>
                ) : (
                  activity.title
                )}
              </h3>
              <p class="text-sm text-muted-foreground">{activity.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="dergi" class="scroll-mt-16 py-16">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <SectionTitle>Bilim Dergisi</SectionTitle>
        {magazine ? (
          <div class={`card grid items-center gap-10 p-6 ${magazine.cover_url ? "sm:grid-cols-[10rem_1fr]" : ""}`}>
            {magazine.cover_url && (
              <a href="/dergi" class="mx-auto block w-40">
                <img
                  src={magazine.cover_url}
                  alt={`Bilim Dergisi Sayı ${toRoman(magazine.issue_number)} kapağı`}
                  width="720"
                  height="1020"
                  loading="lazy"
                  decoding="async"
                  class="h-auto w-full rounded-md border shadow-lg"
                />
              </a>
            )}
            <div class={`text-center ${magazine.cover_url ? "sm:text-left" : ""}`}>
              <p class="tag bg-accent-yellow">{issueLabel(magazine)}</p>
              <p class="mt-3 text-muted-foreground">{magazine.summary || magazine.description}</p>
              <a href="/dergi" class="button mt-6">Dergiyi İncele</a>
            </div>
          </div>
        ) : (
          <p class="mx-auto max-w-2xl text-center text-muted-foreground">
            Bilim Dergisi'nin yeni sayısı hazırlanıyor.
          </p>
        )}
      </div>
    </section>

    <section id="calistay" class="scroll-mt-16 bg-muted/60 py-16">
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
        <div>
          <h2 class="mb-6 text-3xl font-bold text-foreground">Nevzat Ayaz Anadolu Lisesi Fen Bilimleri Çalıştayı</h2>
          <p class="mb-8 text-muted-foreground">
            Öğrencilerimizin düzenlediği iki günlük çalıştayda farklı bilim dallarındaki komiteler uzmanlarla buluşuyor;
            simülasyonlar, deneyler ve atölye etkinlikleri yapılıyor.
          </p>
          <a href="https://fbc.naal.org.tr" target="_blank" rel="noopener noreferrer" class="button gap-2">
            Çalıştay Sitesi
            <Icon svg={arrowTopRightOnSquare} class="h-4 w-4" />
          </a>
        </div>
        <div class="grid w-full grid-cols-2 gap-4">
          <img
            src="/big.jpg"
            alt="Çalıştayda sınıfta yapılan bir sunum"
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
            class="col-span-2 aspect-[2.85/1] h-auto w-full rounded-xl object-cover shadow-sm"
          />
          <img
            src="/kucuksol.jpg"
            alt="Çalıştayda sahnede yapılan bir etkinlik"
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
            class="aspect-[2.1/1] h-auto w-full rounded-xl object-cover shadow-sm"
          />
          <img
            src="/kucuksag.jpg"
            alt="Çalıştayda mikroskopla çalışan öğrenciler"
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
            class="aspect-[2.1/1] h-auto w-full rounded-xl object-cover shadow-sm"
          />
        </div>
      </div>
    </section>

    <section id="basvuru" class="scroll-mt-16 py-16">
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <h2 class="mb-4 text-3xl font-bold text-foreground">Başvuru</h2>
        <p class="mx-auto mb-8 max-w-2xl text-muted-foreground">
          Bilime merakı olan her öğrencimizi kulübümüze bekliyoruz. Söyleşilerde, gezilerde, çalıştaylarda ya da
          Bilim Dergisi'nin yeni sayısında yer almak istiyorsan başvuru formunu doldurman yeterli.
        </p>
        <a href="/basvuru" class="button">Başvuru Formu</a>
      </div>
    </section>

    <section id="instagram" class="scroll-mt-16 border-t py-6">
      <div class="mx-auto flex max-w-7xl flex-wrap justify-center gap-x-8 gap-y-3 px-4 text-sm font-medium text-muted-foreground sm:px-6 lg:px-8">
        {instagramAccounts.map((account) => (
          <a
            href={`https://instagram.com/${account}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 transition-colors hover:text-foreground"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
            @{account}
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
