---
import Header from "@/components/Header.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <Header />
  <main class="mx-auto flex min-h-[70vh] max-w-7xl flex-col items-center justify-center px-4 text-center sm:px-6 lg:px-8">
    <p class="tag bg-accent-yellow">Sayfa bulunamadı</p>
    <h1 class="mb-8 mt-4 text-4xl font-bold text-foreground md:text-5xl">Bu sayfa defterde yok.</h1>
    <a href="/" class="button">Ana sayfaya dön</a>
  </main>
</Layout>
